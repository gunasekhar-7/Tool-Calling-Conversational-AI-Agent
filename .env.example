# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:55432/pm
# Optional: separate DSN for LangGraph checkpoints (defaults to DATABASE_URL).
CHECKPOINT_DSN=

# Required for real model turns. Without it the API starts but /messages returns 503.
OPENAI_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0

# One bearer token per customer: a JSON object of token -> customer UUID.
# There is deliberately no master key, so a leaked token exposes one account only.
CUSTOMER_API_KEYS={"local-dev-alice":"11111111-1111-4111-8111-111111111111","local-dev-grace":"22222222-2222-4222-8222-222222222222"}

ENVIRONMENT=development
LOG_LEVEL=INFO
APPROVAL_TTL_SECONDS=900
MAX_TOOL_CALLS=8
MAX_MESSAGE_CHARS=2000
RATE_LIMIT_PER_MIN=30
RATE_LIMIT_BURST=10

# Dashboard (streamlit run dashboard/app.py). Also readable from .streamlit/secrets.toml.
API_BASE=http://127.0.0.1:8000
# label -> token, used only to render an account picker. Falls back to a token field.
CUSTOMER_TOKENS={"Ada (customer A)":"local-dev-alice","Grace (customer B)":"local-dev-grace"}
